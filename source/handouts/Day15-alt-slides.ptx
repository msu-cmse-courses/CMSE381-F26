                    </tabular>
                </table>
            </introduction>

            <task>
                <statement>
                    <p>
                        What subset of variables is found for
                        <m>\mathcal{M}_0</m> when using best subset selection?
                    </p>
                </statement>

                <choices multiple-correct="yes">
                    <choice correct="yes">
                        <statement>
                            <p>
                                <m>\emptyset</m>
                            </p>
                        </statement>
                    </choice>

                    <choice>
                        <statement>
