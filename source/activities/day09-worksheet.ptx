  <title>Jupyter Day 9 - Section 001: Lec 9 - Intro to Classification</title>
  <introduction>
    <program language="python">
      # Standard imports
      import numpy as np 
      import matplotlib.pyplot as plt
      import pandas as pd 
      %matplotlib inline
      import seaborn as sns
    </program>
