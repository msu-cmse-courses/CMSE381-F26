                            <cell><m>X_1, X_2, X_3</m></cell>
                            <cell>3.08</cell>
                            <cell>5.49</cell>
                        </row>

                        <row>
                            <cell><m>X_1, X_2, X_4</m></cell>
                            <cell>3.55</cell>
                            <cell>4.02</cell>
                        </row>

                        <row>
                            <cell><m>X_1, X_3, X_4</m></cell>
                            <cell>2.97</cell>
                            <cell>4.23</cell>
                        </row>

                        <row>
                            <cell><m>X_2, X_3, X_4</m></cell>
                            <cell>2.98</cell>
                            <cell>3.17</cell>
                        </row>

                        <row>
                            <cell><m>X_1, X_2, X_3, X_4</m></cell>
                            <cell>2.16</cell>
                            <cell>4.39</cell>
