    <program language="python">
    <code>
## Your code here

cols = list(diabetes_df.columns.copy())
cols = cols[:-1]
print(cols)


# Linear regression with Scikit-learn
multiple_X = diabetes_df[cols]
multiple_y = diabetes_df[['target']]

regressor = LinearRegression()
regressor.fit(multiple_X, multiple_y)
print(regressor.coef_)
print(regressor.intercept_)

# Using statsmodels
model = 'target ~ ' + ' + '.join(cols)
print(model)

multiple_est = smf.ols(model, diabetes_df).fit()
multiple_est.summary()
    </code>
