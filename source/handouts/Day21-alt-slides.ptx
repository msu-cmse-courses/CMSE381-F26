  <paragraphs>
    <title>Classification version: Step functions</title>
    <p>
      <md>
        \Pr(y_i&gt;250 \mid x_i) =
        \frac{\exp(\beta_0+\beta_1C_1(x_i)+\beta_2C_2(x_i)+\cdots+\beta_KC_K(x_i))}
        {1+\exp(\beta_0+\beta_1C_1(x_i)+\beta_2C_2(x_i)+\cdots+\beta_KC_K(x_i))}
      </md>
    </p>
    <sidebyside widths="43.75% 56.25%">
