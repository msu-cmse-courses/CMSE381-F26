    <row><cell><m>c_{11}</m></cell><cell>2</cell><cell><m>c_{27}</m></cell><cell>2</cell></row>
    <row><cell><m>c_{12}</m></cell><cell>1</cell><cell><m>c_{28}</m></cell><cell>2</cell></row>
    <row><cell><m>c_{13}</m></cell><cell>2</cell><cell><m>c_{29}</m></cell><cell>2</cell></row>
    <row><cell><m>c_{14}</m></cell><cell>1</cell><cell><m>c_{30}</m></cell><cell>2</cell></row>
    <row><cell><m>c_{15}</m></cell><cell>1</cell><cell><m>c_{31}</m></cell><cell>1</cell></row>
