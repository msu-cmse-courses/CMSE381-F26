                <col width="55%"/>
                <row>
                    <cell>Topic</cell>
                    <cell>Time</cell>
                    <cell>Activity</cell>
                </row>
                <row>
                    <cell>Introduction</cell>
                    <cell>5 mins</cell>
                    <cell>Why high accuracy does not guarantee reliable behavior</cell>
                </row>
                <row>
                    <cell>Failure Mode 1</cell>
                    <cell>12 mins</cell>
                    <cell>Spurious correlations and shortcut learning</cell>
                </row>
                <row>
                    <cell>Failure Mode 2</cell>
                    <cell>10 mins</cell>
                    <cell>Loss of spatial information through pooling</cell>
                </row>
                <row>
                    <cell>Failure Mode 3</cell>
                    <cell>12 mins</cell>
                    <cell>Translation sensitivity</cell>
                </row>
                <row>
                    <cell>Failure Mode 4</cell>
                    <cell>12 mins</cell>
                    <cell>Texture versus shape bias</cell>
                </row>
