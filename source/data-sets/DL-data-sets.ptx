<?xml version="1.0" encoding="UTF-8"?>

<subsection xml:id="deep-learning-examples">
  <title>Deep Learning Data Sets</title>

  <paragraphs xml:id="dl-toy-data">
    <title>DL-toy-data</title>

    <data xml:id="DL-toy-data">
      <p>
        Randomly generated data used for examples in the deep learning module.
      </p>

      <figure xml:id="dl-toy-data-figure">
        <caption>DL-toy-data</caption>
        <image source="data/DL-toy-data.png">
          <shortdescription>
            Randomly generated data with a color gradient going from bottom left
            to top right.
          </shortdescription>
        </image>
      </figure>

      <p>
        Code used for some example creations in the deep learning module.
        Dr.
        Munch generated this using the following code:
      </p>

      <program language="python">
w = np.array([(1,2,1),(-1,0,1),(3,-1,-1)]) # Original choices
beta = np.array((-1,2,1,-2))               # of matrices

np.random.seed(0)
X = np.random.random((30,2))*20-10
y = []
for i in range(30):
    y.append(MyFirstNN(X[i,0],X[i,1],w, beta))
y = np.array(y)

ynoise = y + np.random.random(30)*2-1

data = np.concatenate((X,ynoise.reshape(-1,1)),axis = 1)
      </program>
      <p>
        <dataurl source="data/DL-toy-data.csv" visual="DL-toy-data.csv data file"/>
      </p>
    </data>
  </paragraphs>

  <paragraphs xml:id="dl-toy-data-bigger">
    <title>DL-toy-data-bigger</title>

    <data xml:id="DL-toy-data-bigger">
      <p>
        A larger randomly generated data set used for deep learning examples.
      </p>

      <figure xml:id="dl-toy-data-bigger-figure">
        <caption>DL-toy-data-bigger</caption>
        <image source="data/DL-toy-data-bigger.png">
          <shortdescription>
            Randomly generated data with a color gradient going from bottom left
            to top right.
          </shortdescription>
        </image>
      </figure>

      <program language="python">
def MyFirstNN(X1,X2,w, beta):

    X = np.array((X1,X2))
    A = []

    for i in range(3):
        Ai = w[i,0] + np.dot(w[i,1:],X)
        Ai = 1/(1+np.exp(-Ai))
        A.append(Ai)

    A = np.array(A)

    Y = beta[0] + np.dot(beta[1:], A)

    return Y


w = np.array([(1,2,1),(-1,0,1),(3,-1,-1)]) # Original choices
beta = np.array((-1,2,1,-2))               # of matrices

np.random.seed(0)
n = 500
X = np.random.random((n,2))*20-10
y = []
for i in range(n):
    y.append(MyFirstNN(X[i,0],X[i,1],w, beta))
y = np.array(y)

ynoise = y + np.random.random(n)*2-1

data = np.concatenate((X,ynoise.reshape(-1,1)),axis = 1)
      </program>
      <p>
        <dataurl source="data/DL-toy-data-bigger.csv" visual="DL-toy-data-bigger.csv data file"/>
      </p>
    </data>
  </paragraphs>

  <paragraphs xml:id="dl-toy-image">
    <title>DL-ToyImage</title>

    <data xml:id="DL-ToyImage">
      <p>
        Data used to generate an image for experimenting with convolutional
        filters in the CNN module.
      </p>

      <figure xml:id="dl-toy-image-figure">
        <caption>DL-ToyImage</caption>
        <image source="data/DL-ToyImage.png">
          <shortdescription>
            Randomly generated image with a quarter circle and boundary in
            shades of blue and a green/yellow region between.
          </shortdescription>
        </image>
      </figure>

      <p>
        An image used to try out convolutional filters in the CNN module.
        Data generated using the following code:
      </p>

      <program language="python">
np.random.seed(48824)
M = np.random.random((30,30))
M = np.round(10*M, 1)
for i in range(30):
    for j in range(30):
        if i**2 + j**2 &lt; 15**2:
            M[i,j] -= 10

M[25:,:] -= 10
M[:25,25:] -= 10
      </program>
      <p>
        <dataurl source="data/DL-ToyImage.csv" visual="DL-ToyImage.csv data file"/>
      </p>
    </data>
  </paragraphs>
</subsection>