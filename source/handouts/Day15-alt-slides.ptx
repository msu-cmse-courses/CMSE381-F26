                                <m>\{X_1\}</m>
                            </p>
                        </statement>
                    </choice>

                    <choice>
                        <statement>
                            <p>
                                <m>\{X_2\}</m>
                            </p>
                        </statement>
                    </choice>

                    <choice>
                        <statement>
                            <p>
                                <m>\{X_3\}</m>
                            </p>
                        </statement>
                    </choice>

                    <choice>
                        <statement>
                            <p>
                                <m>\{X_4\}</m>
                            </p>
                        </statement>
                    </choice>
                </choices>
