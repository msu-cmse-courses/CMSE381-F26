    <task>
      <title>Making Predictions</title>

      <statement>
        <p>
          Suppose we fit the following classification tree to the data:
        </p>

        <image source="figures/classification_tree_ex1.png">
          <shortdescription>
            Classification tree with a root split at Age less than or equal to
            36.
            The left branch splits on Student status, predicting Yes for
            students and No for nonstudents.
            The right branch splits on Income less than or equal to 75,
            predicting No for income at most 75 and Yes otherwise.
          </shortdescription>
        </image>

        <p>
          Use the classification tree to predict whether each of the following
          new customers will purchase a subscription:
          <ol>
            <li>
              <p>
                Age = 27, income = $40,000, student = Yes.
              </p>
            </li>

            <li>
              <p>
                Age = 27, income = $40,000, student = No.
              </p>
            </li>

            <li>
              <p>
                Age = 42, income = $65,000, student = Yes.
              </p>
            </li>

            <li>
              <p>
                Age = 50, income = $90,000, student = No.
              </p>
            </li>
          </ol>
        </p>
      </statement>

      <answer>
        <p>
          <ul>
            <li>
              <p>
                Yes
              </p>
            </li>

            <li>
              <p>
                No
              </p>
            </li>

            <li>
              <p>
                No
              </p>
            </li>

            <li>
              <p>
                Yes
              </p>
            </li>
          </ul>
        </p>
      </answer>
    </task>
