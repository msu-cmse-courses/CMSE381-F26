        <p>
          For each region, calculate the RSS and the mean response that
          correspond to that split.
          Use the following table.
          Which split is best?
        </p>

        <table>
          <title>RSS Breakdown by Split</title>

          <tabular halign="center">
            <row header="yes" bottom="minor">
              <cell>Split</cell>
              <cell>Mean response for <m>X \lt s_i</m></cell>
              <cell>Mean response for <m>X \ge s_i</m></cell>
              <cell>RSS for <m>X \lt s_i</m></cell>
              <cell>RSS for <m>X \ge s_i</m></cell>
              <cell>Total RSS</cell>
            </row>

            <row>
              <cell><m> s_1</m></cell>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
            </row>

            <row>
              <cell><m> s_2</m></cell>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
            </row>

            <row>
              <cell><m> s_3</m></cell>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
            </row>

            <row>
              <cell><m> s_4</m></cell>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
            </row>

            <row>
              <cell><m> s_5</m></cell>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
              <cell/>
            </row>
          </tabular>
        </table>
      </statement>

      <answer>
        <table>
          <title>RSS Breakdown by Split</title>

          <tabular halign="center">
            <row header="yes" bottom="minor">
              <cell>Split</cell>
              <cell>Mean response for <m>X \lt s_i</m></cell>
              <cell>Mean response for <m>X \ge s_i</m></cell>
              <cell>RSS for <m>X \lt s_i</m></cell>
              <cell>RSS for <m>X \ge s_i</m></cell>
              <cell>Total RSS</cell>
            </row>

            <row>
              <cell><m> s_1=1.80</m></cell>
              <cell>2.100</cell>
              <cell>6.620</cell>
              <cell>0.000</cell>
              <cell>27.688</cell>
              <cell>27.688</cell>
            </row>

            <row>
              <cell><m> s_2=2.75</m></cell>
              <cell>2.750</cell>
              <cell>7.425</cell>
              <cell>0.845</cell>
              <cell>14.728</cell>
              <cell>15.573</cell>
            </row>

            <row>
              <cell><m> s_3=3.90</m></cell>
